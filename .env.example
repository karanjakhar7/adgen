# LLM configuration (LiteLLM model strings; see https://docs.litellm.ai/docs/providers)
# Model routing is config, not code — adtech/config.py maps each pipeline stage
# to the "fast" or "strong" model class below.
LLM_MODEL_FAST=gemini/gemini-3.1-flash-lite
LLM_MODEL_STRONG=gemini/gemini-3.1-flash
LLM_TIMEOUT_SECONDS=60

# Logging.
# LOG_LEVEL controls app logs: DEBUG, INFO, WARNING, ERROR.
# LOG_FORMAT can be "text" or "json".
# LITELLM_LOG_LEVEL keeps provider/client noise separate from app logs.
LOG_LEVEL=INFO
LOG_FORMAT=text
LITELLM_LOG_LEVEL=ERROR

# Provider credentials.
# LiteLLM infers which key to read from the model name prefix, e.g.:
#   gemini/...  -> GEMINI_API_KEY
#   claude-...  -> ANTHROPIC_API_KEY
#   gpt-...     -> OPENAI_API_KEY
GEMINI_API_KEY=replace-with-your-key
